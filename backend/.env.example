# Copy to .env and adjust as needed for local dev.
APP_ENV=development
# Local dev uses the Docker Postgres below. Production uses Neon: paste Neon's
# connection string as-is (postgresql://user:pass@host/dbname?sslmode=require).
# The app rewrites postgres:// and postgresql:// to the psycopg3 driver and
# keeps sslmode. Prefer Neon's direct (non "-pooler") host: migrations run at
# boot and are simplest over a direct connection.
DATABASE_URL=postgresql+psycopg://musper:musper@localhost:5434/musper

# Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# JWT / auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_REFRESH_REMEMBER_TTL_DAYS=30
RESET_TOKEN_TTL_MINUTES=30
VERIFY_TOKEN_TTL_HOURS=24

# Cookies — set COOKIE_SECURE=true in production (requires HTTPS).
# COOKIE_SAMESITE stays "lax" when the frontend proxies /api to the backend
# (Vite dev proxy locally, static-site rewrite rules on Render). Only set
# "none" for a genuinely cross-site setup, and then COOKIE_SECURE must be true.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Anthropic Claude API (Phase 4 — diagnostic chatbot)
# Create a key at https://console.anthropic.com/ and paste it into your local .env
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1024
# Hard timeout per Claude call (seconds); protects workers from hanging requests.
CLAUDE_TIMEOUT_SECONDS=45
# Max user turns per interview before it closes gracefully (cost ceiling).
DIAGNOSTIC_MAX_USER_TURNS=60

# Transactional email (Resend) - sign up at https://resend.com, create an API key.
# Leave empty in dev to log reset links to the console instead of sending.
RESEND_API_KEY=
# Switch to "MusperSolutions <no-reply@muspersolutions.com>" once the domain is verified in Resend.
EMAIL_FROM=MusperSolutions <onboarding@resend.dev>
